# Air Quality Monitoring System – Arduino Program


#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>

// ---------------- SENSOR PINS ----------------
#define MQ135_PIN A0
#define MQ7_PIN   A1
#define DHTPIN    2
#define DHTTYPE   DHT11

// ---------------- OBJECTS ----------------
DHT dht(DHTPIN, DHTTYPE);
LiquidCrystal_I2C lcd(0x27, 16, 2);

// ---------------- VARIABLES ----------------
int mq135Value = 0;
int mq7Value = 0;
float temperature;
float humidity;

void setup() {
  Serial.begin(9600);

  // Initialize LCD
  lcd.init();
  lcd.backlight();

  // Initialize DHT Sensor
  dht.begin();

  lcd.setCursor(0, 0);
  lcd.print("Air Quality");
  lcd.setCursor(0, 1);
  lcd.print("Monitoring Sys");

  delay(2000);
  lcd.clear();
}

void loop() {

  // Read MQ Sensors
  mq135Value = analogRead(MQ135_PIN);
  mq7Value = analogRead(MQ7_PIN);

  // Read Temperature and Humidity
  temperature = dht.readTemperature();
  humidity = dht.readHumidity();

  // Print Sensor Values to Serial Monitor
  Serial.println("===== AIR QUALITY DATA =====");

  Serial.print("MQ135 Value: ");
  Serial.println(mq135Value);

  Serial.print("MQ7 Value: ");
  Serial.println(mq7Value);

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");

  Serial.print("Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  // Air Quality Status
  String airQuality;

  if (mq135Value < 150) {
    airQuality = "GOOD";
  }
  else if (mq135Value >= 150 && mq135Value < 300) {
    airQuality = "MODERATE";
  }
  else {
    airQuality = "POOR";
  }

  Serial.print("Air Quality: ");
  Serial.println(airQuality);

  // Display on LCD
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("AQ:");
  lcd.print(airQuality);

  lcd.setCursor(0, 1);
  lcd.print("T:");
  lcd.print(temperature);
  lcd.print("C ");

  delay(2000);

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("MQ135:");
  lcd.print(mq135Value);

  lcd.setCursor(0, 1);
  lcd.print("H:");
  lcd.print(humidity);
  lcd.print("%");

  delay(2000);
}
